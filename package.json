{
  "name": "spoons-price-checker",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently -k -n db,app -c blue,green \"yarn dev:db\" \"nuxt dev\"",
    "dev:db": "yarn dlx prisma dev --name spoons-price-checker",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/fonts": "0.14.0",
    "@nuxt/scripts": "1.3.2",
    "@nuxtjs/robots": "^6.1.4",
    "@nuxtjs/sitemap": "^8.3.4",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.7.2",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.7.8",
    "nuxt-schema-org": "^6.2.9",
    "nuxt-seo-utils": "^8.4.2",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1"
  },
  "packageManager": "yarn@4.17.1"
}
